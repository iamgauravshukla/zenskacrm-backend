
# Zenska CRM — Backend Environment Variables

# :warning: DO NOT COMMIT THIS FILE TO GIT

# ═══════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────

PORT=8000
NODE_ENV=development

# ─── MongoDB ─────────────────────────────────────────

MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/zenska-crm

# ─── JWT ─────────────────────────────────────────────

JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRES_IN=7d

# ─── Frontend URL (used in reset-password links) ──────

CLIENT_URL=http://localhost:3000

# Production example:
# CLIENT_URL=https://crm.yourdomain.com

# ═══════════════════════════════════════════════════════

# Resend Email

# ═══════════════════════════════════════════════════════

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_your_real_api_key

# In test mode, Resend only delivers to your own account email.
# To send forgot-password emails to any user, verify a domain in Resend
# and use a sender address from that domain.
RESEND_FROM=Zenska CRM <no-reply@yourdomain.com>

# ─── Login email notifications ────────────────────────

SEND_LOGIN_EMAILS=true